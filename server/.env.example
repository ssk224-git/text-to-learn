# Copy this file to .env and fill in the values. Never commit .env.
PORT=5000
# Frontend URL(s) allowed to call this API (comma-separated)
CLIENT_ORIGIN=http://localhost:5173

MONGO_URI=

AI_PROVIDER=gemini
GEMINI_API_KEY=
# Optional model overrides (defaults live in config/env.js)
GEMINI_MODEL=
GEMINI_TTS_MODEL=

YOUTUBE_API_KEY=

# Leave both empty to run in dev mode (no login; everything is saved under "dev-user").
# AUTH0_ISSUER looks like https://your-tenant.us.auth0.com/
AUTH0_ISSUER=
AUTH0_AUDIENCE=
